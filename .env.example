# Application Environment Configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (Defaults to SQLite; uncomment PostgreSQL for production)
DATABASE_URL=sqlite:///./data/construction_risk.db
# DATABASE_URL=postgresql://user:password@localhost:5432/construction_risk

# Model & Detection Configuration
DEFAULT_MODEL_WEIGHTS=models/runs/yolov8n_construction_safety/weights/best.pt
DEFAULT_CONFIDENCE_THRESHOLD=0.25
DEFAULT_IOU_THRESHOLD=0.45

# Risk Engine Thresholds
ALERT_RISK_THRESHOLD=50
CRITICAL_RISK_THRESHOLD=75
